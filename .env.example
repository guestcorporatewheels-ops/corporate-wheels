# Frontend — browser (Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_MAPS_API_KEY=

# Optional
VITE_PUBLIC_BUILDER_KEY=
PING_MESSAGE="ping pong"

# Backend — see backend/.env.example

# AI chat widget (server-side only — no VITE_ prefix, never exposed to the browser)
# Get a key at https://kie.ai
KIE_API_KEY=
# Any kie.ai chat model route, e.g. gemini-2.5-flash, gemini-3-flash, gpt-5-2
KIE_MODEL_ROUTE=gemini-2.5-flash

# Chat lead notifications — reuses the same SMTP account as booking notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where new chatbot leads are emailed (falls back to BOOKING_ADMIN_EMAIL)
CHATBOT_ADMIN_EMAIL=
BOOKING_ADMIN_EMAIL=
